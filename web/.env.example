# Copy thành .env.local rồi điền giá trị. KHÔNG commit .env.local.
# Biến mới: khai báo trong src/lib/env.ts và thêm vào file này.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI (tuỳ chọn) — xem src/ai/AGENTS.md ---
# AI_PROVIDER=anthropic
# AI_MODEL=
# AI_API_KEY=

# --- Database (Supabase, read-only) — xem src/server/AGENTS.md ---
# Dùng pooler URI (port 6543): postgresql://USER:PASS@HOST.pooler.supabase.com:6543/postgres
DATABASE_URL=
