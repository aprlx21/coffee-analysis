# Supabase PostgreSQL Database Connection URL
# Lấy tại Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Lưu ý: Nếu mạng chặn port 5432 hoặc dùng máy bay/mạng cơ quan, hãy dùng connection pooler port 6543 hoặc 5432.
SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# (Tuỳ chọn) Supabase Project API URL & Anon Key nếu dùng cho Frontend / Client SDK
NEXT_PUBLIC_SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
